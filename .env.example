# Copy to .env and fill in. Never commit .env.

# Where captures, worlds, datasets, checks and logs go (default: ./data in the repo).
# A dataset with clean plates needs about 2.6 MB per picture while capturing.
MOBDATASET_DATA=

# Minecraft server folder (server jar, server.properties) and game folder (options.txt, mods).
MC_SERVER_DIR=
MC_CLIENT_DIR=

# Microsoft account email the game signs in with (through PortableMC).
MC_LOGIN=

# Remote console of the local server; must match server.properties.
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=
